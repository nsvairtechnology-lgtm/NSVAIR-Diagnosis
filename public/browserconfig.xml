<?xml version="1.0" encoding="utf-8"?>
<browserconfig>
  <msapplication>
    <tile>
      <square150x150logo src="/icon.svg"/>
      <TileColor>#10b981</TileColor>
    </tile>
    <notification>
      <template tileTemplate="TileSquareImage"/>
      <binding template="TileSquareImage">
        <image id="1" src="/icon.svg"/>
      </binding>
    </notification>
  </msapplication>
</browserconfig>
